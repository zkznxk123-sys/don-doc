# ─────────────────────────────────────────────────────────────────────────
# 돈독 — 환경 변수 예시. `cp .env.local.example .env.local` 후 값 채워 사용.
# ─────────────────────────────────────────────────────────────────────────

# ─── 제품 라인 (Phase 1: 제품 분리) ────────────────────────────────────────
# full = 개인 가족 전체 기능 (default)
# lite = 대중 공개·압축 (가족 공유·시나리오·매매 자동·연금 상세·CFO 권한 제외)
# 미설정 시 'full'. specs/product-split-decision-20260610.md 참조.
NEXT_PUBLIC_PRODUCT_LINE=full

# ─── 인증 (Clerk) ─────────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# ─── DB (Supabase Postgres + Prisma) ──────────────────────────────────────
# 주의: 이 두 키는 .env 파일에 두는 것이 prisma CLI 기본 동작과 맞다.
DATABASE_URL=          # Postgres pooled connection (apps 사용)
DIRECT_URL=            # Postgres direct connection (prisma migrate 사용)

# ─── 분석 (PostHog) ───────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ─── 외부 API ─────────────────────────────────────────────────────────────
# fran.kr 세금 계산 (보유세·취득세·양도세·증여세·상속세)
FRANKR_CLIENT_ID=
FRANKR_CLIENT_SECRET=
# 국토교통부 실거래가 API (부동산)
MOLIT_API_KEY=
# 카카오 REST (검색·지도 등)
KAKAO_REST_API_KEY=
# 한국투자증권 KIS API (선택 — 자동 잔액 동기화)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_IS_MOCK=true
KIS_ID=
# 금융감독원 DART (선택 — 종목 펀더멘털)
DART_API_KEY=

# ─── LLM ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=        # 일부 AI 분류·임베딩에 사용
# LLM Mux (자체 LLM 라우팅 서버) — 미설정 시 http://localhost:8317 기본값
LLM_MUX_URL=
LLM_MUX_MODEL_FAST=
LLM_MUX_MODEL_BALANCED=
LLM_MUX_MODEL_SMART=
# Claude Code CLI proxy (선택 — 시나리오 챗 등)
CLI_PROXY_URL=
CLI_PROXY_API_KEY=
CLI_PROXY_MGMT_SECRET=

# ─── 데모 (/api/demo/data 가 사용) ────────────────────────────────────────
# 무인증 공개 엔드포인트가 조회할 가명/가상 데모 가족 정보.
# 실명/실데이터 계정은 절대 지정하지 말 것.
DEMO_CFO_EMAIL=demo-cfo@example.com
DEMO_CFO_CLERK_ID=
DEMO_MEMBER_EMAIL=demo-member@example.com
DEMO_MEMBER_CLERK_ID=

# ─── 종목 리서치 베타 (딥다이브·ETF NAV — 개인 비공개) ─────────────────────
# 허용 계정만 접근(콤마 구분). 미설정 시 전원 차단(fail-closed) — 컴플라이언스 가드.
RESEARCH_BETA_EMAILS=
# dartlab 재무 분석 서비스 (service/dondoc_deep_dive.py, 기본 127.0.0.1:8420)
DARTLAB_SERVICE_URL=
# 한국투자 실전 앱키 — ETF 구성종목시세(073)는 모의투자 미지원
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
