// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CFO // 대표 관리자: 가족 생성자, 전체 접근
  CO_CFO // 공동 관리자: CFO와 동일한 접근 권한 (부부 공동 관리 등)
  MEMBER // 구성원: 개인 지출 및 공동 지출 기여
}

enum CategoryType {
  EXPENSE // 지출 카테고리
  INCOME // 수입 카테고리
}

enum Visibility {
  SHARED // 가족 모두에게 상세 내역 공개
  PRIVATE // 본인 외에는 '합계'만 노출 (상세 내역 마스킹)
}

enum AccountType {
  CASH // 현금/예적금
  INVESTMENT // 주식/펀드
  PENSION // 연금 (IRP, 연금저축 등)
  CRYPTO // 가상자산
  REAL_ESTATE // 부동산
  STO // 토큰증권 (장기 확장성)
  DEBT // 대출 (부채)
  CREDIT_CARD // 신용카드 (부채)
}

enum ShareLevel {
  PUBLIC // 내역까지 공개 — 가족 모두가 볼 수 있음
  BALANCE_ONLY // 금액만 합산 — 이름/내역 숨김, 금액만 표시
  PRIVATE // 나만 보기 — 타인 리스트에서 완전 제외
}

enum RepaymentType {
  EQUAL_PRINCIPAL_INTEREST // 원리금균등
  EQUAL_PRINCIPAL // 원금균등
  BULLET // 만기일시
  INTEREST_ONLY // 이자만납부
}

enum DebtType {
  MORTGAGE // 주택담보대출
  JEONSE_DEPOSIT // 전세보증금(수취)
  CREDIT_LOAN // 신용대출
  OVERDRAFT // 마이너스통장
  ETC // 기타
}

enum TradeType {
  BUY // 매수
  SELL // 매도
  DIVIDEND // 배당/분배금
  SPLIT // 액면분할
}

enum PensionType {
  PUBLIC_PENSION // 공적연금 (국민연금, 공무원연금 등)
  RETIREMENT_DB // 퇴직연금 DB형 (확정급여형)
  RETIREMENT_DC // 퇴직연금 DC형 (확정기여형)
  IRP // 개인형 퇴직연금 (IRP)
  PERSONAL_PENSION // 개인연금 (연금저축펀드/보험)
  HOME_PENSION // 주택연금
}

model FamilyGroup {
  id                String               @id @default(cuid())
  name              String // 예: "우리집", "공동 자산 운영"
  aiMode            String               @default("api") // "api" | "proxy"
  users             User[]
  accounts          Account[]
  invites           FamilyInvite[]
  budgets           Budget[]
  categories        Category[]
  monthlyGoals      MonthlyGoal[]
  accountTypeLabels AccountTypeLabel[]
  netWorthSnapshots NetWorthSnapshot[]
  targetProperties  TargetProperty[]
  contentSources    ContentSource[]
  scenarios         Scenario[]
  familyPosts       FamilyPost[]
  oauthAccounts     FamilyOAuthAccount[]
  oauthSessions     FamilyOAuthSession[]
  uploadBatches     UploadBatch[]
  excelMappings     ExcelMapping[]
  createdAt         DateTime             @default(now())
}

model Category {
  id           String        @id @default(cuid())
  name         String
  icon         String
  type         CategoryType
  familyId     String? // null = 시스템 기본값, non-null = 가족 커스텀
  family       FamilyGroup?  @relation(fields: [familyId], references: [id])
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model FamilyInvite {
  id        String      @id @default(cuid())
  code      String      @unique // 6자리 초대 코드 (대문자+숫자)
  familyId  String
  family    FamilyGroup @relation(fields: [familyId], references: [id])
  createdBy String // CFO userId
  usedBy    String? // 사용한 유저 email
  usedAt    DateTime?
  expiresAt DateTime // 만료 시각
  createdAt DateTime    @default(now())
}

model User {
  id                     String                   @id @default(cuid())
  clerkId                String?                  @unique // Clerk user ID (user_xxxx)
  email                  String                   @unique
  name                   String?
  role                   Role                     @default(MEMBER)
  familyId               String?
  family                 FamilyGroup?             @relation(fields: [familyId], references: [id])
  transactions           Transaction[]
  accounts               Account[]
  budgets                Budget[]
  categoryPreferences    UserCategoryPreference[]
  familyPosts            FamilyPost[]
  postComments           PostComment[]
  postReactions          PostReaction[]
  taggedInPosts          FamilyPost[]             @relation("FamilyPostTaggedUsers")
  oauthAccountsConnected FamilyOAuthAccount[]
  oauthSessionsStarted   FamilyOAuthSession[]
  uploadBatches          UploadBatch[]
  /// 개인 설정 (자산 표시 임계값·기본 가시성 등) — 기기 간 동기화. 키 스키마는 lib/user-preferences.ts
  preferences            Json?

  @@index([familyId])
}

model PensionDetail {
  id                     String      @id @default(cuid())
  accountId              String      @unique
  account                Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pensionType            PensionType @default(PERSONAL_PENSION)
  institutionName        String? // 기관명 (예: 국민연금공단, 삼성생명)
  expectedMonthlyPension Float? // 예상 월 수령액
  taxDeductible          Boolean     @default(false) // 세액공제 대상 (IRP/개인연금)
  accumulatedMonths      Int? // 누적 납입 개월 수
  pensionStartAge        Int? // 연금 개시 예정 나이
  monthlyPayment         Float? // 월 납입액
  ownerBirthYear         Int? // 가입자 출생연도 (수령까지 남은 기간 계산)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model UserCategoryPreference {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword    String // normalized description (lowercase, trimmed)
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, keyword])
}

model Account {
  id           String        @id @default(cuid())
  name         String // 예: "생활비 통장", "개인 비상금"
  type         AccountType   @default(CASH)
  balance      Float         @default(0)
  isShared     Boolean       @default(true) // 공동 자산 여부 (shareLevel에서 파생)
  shareLevel   ShareLevel    @default(PUBLIC) // 공유 수준
  familyId     String
  family       FamilyGroup   @relation(fields: [familyId], references: [id])
  userId       String? // 명의자 (null = 미설정 or 공동)
  user         User?         @relation(fields: [userId], references: [id])
  isJoint      Boolean       @default(false) // 공동 명의 여부
  transactions Transaction[]

  // 계층 구조 — 예: IRP → 채권펀드, 미래에셋계좌 → 국내주식펀드
  parentAccountId String?
  parentAccount   Account?  @relation("SubAccounts", fields: [parentAccountId], references: [id])
  subAccounts     Account[] @relation("SubAccounts")

  // 부채가 종속된 자산 (self-relation) — 예: 주택담보대출 → 아파트
  linkedAssetId String?
  linkedAsset   Account?  @relation("DebtToAsset", fields: [linkedAssetId], references: [id])
  linkedDebts   Account[] @relation("DebtToAsset")

  // 유형별 상세 정보 (1:1)
  realEstateDetail     RealEstateDetail?
  financialAssetDetail FinancialAssetDetail?
  debtDetail           DebtDetail?
  pensionDetail        PensionDetail?
  holdings             InvestmentHolding[] // INVESTMENT/CRYPTO 계좌 종목 목록
  priceHistory         RealEstatePriceHistory[] // REAL_ESTATE 시세 이력
  balanceChanges       BalanceChangeLog[]

  @@index([familyId, parentAccountId])
  @@index([userId])
}

model Transaction {
  id                String        @id @default(cuid())
  amount            Float
  date              DateTime      @default(now())
  description       String // 이 필드가 마스킹 대상
  category          String // 카테고리 이름 (표시용, 하위호환)
  categoryId        String? // Category 모델 FK (선택)
  categoryRef       Category?     @relation(fields: [categoryId], references: [id])
  visibility        Visibility    @default(PRIVATE)
  isExcluded        Boolean       @default(false) // 통계 제외 여부
  excludeFromBudget Boolean       @default(false) // 예산 집계 제외 여부
  originalHash      String?       @unique // 엑셀 원본 Row 식별자 SHA-256 (userId|date|amount|desc|accountName)
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  accountId         String
  account           Account       @relation(fields: [accountId], references: [id])
  // 분할 항목 (self-relation)
  parentId          String?
  parent            Transaction?  @relation("SubTransactions", fields: [parentId], references: [id], onDelete: Cascade)
  subItems          Transaction[] @relation("SubTransactions")
  familyPosts       FamilyPost[]
  uploadBatchId     String?
  uploadBatch       UploadBatch?  @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  // 매매내역(TradeRecord)으로 인해 자동 생성된 거래 — trade 삭제 시 cascade
  tradeRecordId     String?
  tradeRecord       TradeRecord?  @relation(fields: [tradeRecordId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([accountId])
  @@index([parentId])
  @@index([uploadBatchId])
  @@index([tradeRecordId])
}

// 엑셀 업로드 / 잔액 동기화 1건 단위 추적 (어떤 거래·잔액 변경이 같은 업로드에서 일어났는지)
model UploadBatch {
  id             String             @id @default(cuid())
  familyId       String
  family         FamilyGroup        @relation(fields: [familyId], references: [id])
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  fileName       String?
  source         String             @default("excel") // 'excel' | 'banksalad' | 'manual-sync'
  txAdded        Int                @default(0)
  txSkipped      Int                @default(0)
  syncedAccounts Int                @default(0)
  uploadedAt     DateTime           @default(now())
  transactions   Transaction[]
  balanceChanges BalanceChangeLog[]

  @@index([familyId, uploadedAt])
  @@index([userId])
}

// 계좌 잔액 변경 이력 — 자산 추적용
model BalanceChangeLog {
  id            String       @id @default(cuid())
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  oldBalance    Float
  newBalance    Float
  delta         Float // newBalance - oldBalance
  source        String       @default("excel") // 'excel' | 'manual' | 'auto'
  uploadBatchId String?
  uploadBatch   UploadBatch? @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)
  changedAt     DateTime     @default(now())

  @@index([accountId, changedAt])
  @@index([uploadBatchId])
}

model RealEstateDetail {
  id             String    @id @default(cuid())
  accountId      String    @unique
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  propertyType   String? // 아파트, 빌라, 오피스텔, 토지 등
  complexName    String? // 단지명 (예: 래미안원베일리)
  bjdCode        String? // 법정동 코드 5자리 (국토부 API용, 예: 11650)
  area           Float? // 전용면적 (㎡)
  floor          Int? // 층
  purchasePrice  Float? // 매수 원금 (취득가)
  purchaseDate   DateTime? // 매수일
  currentPrice   Float? // 현재 시세 (수기 입력 또는 API 마지막값)
  priceUpdatedAt DateTime? // 시세 마지막 업데이트
  targetPrice    Float? // 목표 매도가
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model FinancialAssetDetail {
  id             String    @id @default(cuid())
  accountId      String    @unique
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  interestRate   Float? // 수익률 또는 이율 (% 단위, 예: 4.5)
  maturityDate   DateTime? // 만기일
  monthlyPayment Float? // 월 납입액 (적금 등)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model DebtDetail {
  id             String         @id @default(cuid())
  accountId      String         @unique
  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debtType       DebtType       @default(ETC) // 부채 세부 유형
  interestRate   Float? // 대출 금리 (% 단위, 예: 3.8)
  maturityDate   DateTime? // 대출 만기일
  repaymentType  RepaymentType? // 상환 방식
  monthlyPayment Float? // 월 상환액
  includeInLtv   Boolean        @default(true) // LTV 계산 포함 여부
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Budget {
  id        String      @id @default(cuid())
  amount    Float
  month     String // "YYYY-MM"
  familyId  String
  family    FamilyGroup @relation(fields: [familyId], references: [id])
  userId    String? // null = 가족 전체 예산, non-null = 특정 멤버 예산
  user      User?       @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([familyId, month])
}

model AccountTypeLabel {
  id       String      @id @default(cuid())
  type     AccountType
  label    String
  familyId String
  family   FamilyGroup @relation(fields: [familyId], references: [id])

  @@unique([type, familyId])
}

model NetWorthSnapshot {
  id               String      @id @default(cuid())
  familyId         String
  family           FamilyGroup @relation(fields: [familyId], references: [id])
  yearMonth        String // "YYYY-MM"
  totalAssets      Float       @default(0)
  totalLiabilities Float       @default(0)
  netWorth         Float       @default(0)
  // 그룹별 잔액 합산 — 차트 tooltip에서 전월 대비 어느 그룹에서 변동이 큰지 표시.
  // { realEstate: number, financial: number, pension: number, debt: number }
  // 6/10 도입 — 기존 스냅샷은 null, 신규부터 채워짐. 마이그레이션 없이 db push.
  typeBreakdown    Json?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([familyId, yearMonth])
}

model MonthlyGoal {
  id                String      @id @default(cuid())
  month             String // "YYYY-MM"
  targetIncome      Float       @default(0)
  targetExpense     Float       @default(0)
  targetSavingsRate Float       @default(0) // 퍼센트 (예: 30.0 = 30%)
  familyId          String
  family            FamilyGroup @relation(fields: [familyId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([familyId, month])
}

model InvestmentHolding {
  id           String        @id @default(cuid())
  accountId    String
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticker       String? // 티커 심볼 (예: 005930, AAPL, 005930.KS)
  market       String? // KRX, NASDAQ, NYSE, CRYPTO, ETF 등
  name         String // 종목명 (예: 삼성전자, Apple Inc.)
  quantity     Float // 보유 수량
  avgPrice     Float // 평균 매수가 (원 또는 달러)
  currentPrice Float? // 현재가 (마지막 조회값)
  currency     String        @default("KRW") // KRW, USD 등
  lastUpdated  DateTime? // 현재가 마지막 업데이트
  memo         String?
  trades       TradeRecord[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([accountId])
}

model TradeRecord {
  id           String            @id @default(cuid())
  holdingId    String
  holding      InvestmentHolding @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  type         TradeType // BUY, SELL, DIVIDEND, SPLIT
  quantity     Float // 수량 (DIVIDEND는 금액)
  price        Float // 단가 (DIVIDEND는 주당 배당금)
  fee          Float? // 수수료/세금
  date         DateTime
  memo         String?
  // 이 매매로 인해 가계부에 자동 생성된 거래 (손익, 배당, 수수료 등)
  transactions Transaction[]
  createdAt    DateTime          @default(now())

  @@index([holdingId])
}

// ── 부동산 시세 이력 ──────────────────────────────────────────────────────────
model RealEstatePriceHistory {
  id        String          @id @default(cuid())
  accountId String? // 보유 부동산 (null이면 target)
  account   Account?        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  targetId  String? // 목표 단지
  target    TargetProperty? @relation(fields: [targetId], references: [id], onDelete: Cascade)
  yearMonth String // "YYYY-MM"
  price     Float // 중앙값 (원)
  priceMin  Float? // 최저 거래가 (원, MOLIT)
  priceMax  Float? // 최고 거래가 (원, MOLIT)
  area      Float? // 실거래 면적 (㎡), 국토부 조회 시 기록
  source    String          @default("MANUAL") // MANUAL | MOLIT
  createdAt DateTime        @default(now())

  @@index([accountId, yearMonth])
  @@index([targetId, yearMonth])
}

// ── 갈아타기 목표 단지 ─────────────────────────────────────────────────────────
model TargetProperty {
  id           String                   @id @default(cuid())
  familyId     String
  family       FamilyGroup              @relation(fields: [familyId], references: [id])
  name         String // 단지명 (예: 래미안원베일리)
  bjdCode      String? // 법정동 코드 5자리
  area         Float? // 목표 전용면적 (㎡)
  budget       Float? // 목표 예산 (원)
  currentPrice Float? // 최근 시세 캐시 (원)
  lastUpdated  DateTime? // 시세 마지막 업데이트
  memo         String?
  priceHistory RealEstatePriceHistory[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([familyId])
}

// ── 시나리오 허브 ──────────────────────────────────────────────────────────────

model ContentSource {
  id               String      @id @default(cuid())
  familyId         String
  family           FamilyGroup @relation(fields: [familyId], references: [id])
  type             String      @default("url") // "url" | "text"
  url              String? // type=url일 때만 사용
  title            String?
  summary          String?
  // 요약 진단 정보
  summaryStatus    String? // 'success' | 'failed' | 'too_short' | 'fetch_failed'
  summaryError     String? // 실패 사유 텍스트
  extractedLength  Int? // 추출된 원문 글자수
  extractedPreview String? // 추출 원문 첫 500자 (빠른 표시용)
  extractedText    String? // 추출 원문 전문 (AI에 보낸 그대로)
  extractedTextKo  String? // 비한국어 원문일 때 한국어 번역. 한국어 원문이면 null.
  summarizedAt     DateTime?
  categories       String[]    @default([]) // SCENARIO_CATEGORIES 중 0~다수, AI 자동 분류 + 사용자 수정 가능
  createdAt        DateTime    @default(now())

  @@index([familyId])
}

model Scenario {
  id               String                @id @default(cuid())
  familyId         String
  family           FamilyGroup           @relation(fields: [familyId], references: [id])
  title            String
  category         String? // 부동산/투자/부채/현금흐름/연금 등
  rationale        String // 왜 지금 나에게 관련있는지
  gap              String? // 필요조건 vs 현재 갭
  timeline         String? // 예상 타임라인
  risk             String? // 주요 리스크
  actions          String[] // 다음 액션 목록
  completedActions Int[] // 완료된 액션 인덱스 목록
  feasibility      Int // 실행 가능성 0~100
  sourceIds        String[] // 참조한 ContentSource ids
  status           String                @default("active") // active | interested | dismissed | archived
  generationBatch  String                @default("") // 같은 생성 회차 그룹핑 (cuid)
  expansion        Json? // 상세 실행 계획 (expandScenario 호출 후)
  embedding        Float[]               @default([]) // title+rationale 임베딩 (text-embedding-3-small) — 유사도 기반 대체 판단
  generatedAt      DateTime              @default(now())
  chatMessages     ScenarioChatMessage[]

  @@index([familyId])
  @@index([generationBatch])
}

model ScenarioChatMessage {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  role       String // user | assistant
  content    String
  createdAt  DateTime @default(now())

  @@index([scenarioId])
}

model FamilyPost {
  id            String         @id @default(cuid())
  familyId      String
  family        FamilyGroup    @relation(fields: [familyId], references: [id])
  authorId      String
  author        User           @relation(fields: [authorId], references: [id])
  type          String         @default("text") // text | txn_ref
  content       String
  isPinned      Boolean        @default(false)
  transactionId String?
  transaction   Transaction?   @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  taggedUsers   User[]         @relation("FamilyPostTaggedUsers")
  comments      PostComment[]
  reactions     PostReaction[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([familyId])
}

model PostComment {
  id        String     @id @default(cuid())
  postId    String
  post      FamilyPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime   @default(now())

  @@index([postId])
}

model PostReaction {
  id        String     @id @default(cuid())
  postId    String
  post      FamilyPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  emoji     String // ✅ 👍 🤔 ❤️
  createdAt DateTime   @default(now())

  @@unique([postId, userId, emoji])
  @@index([postId])
}

// 가족별 CLIProxy OAuth 계정 연결.
// CLIProxy가 토큰 자체는 자기 볼륨(/data/auths)에 보관하므로,
// 여기엔 매핑 메타데이터만 저장: 어떤 가족이 어떤 authId를 쓰는지.
model FamilyOAuthAccount {
  id                String      @id @default(cuid())
  familyId          String
  family            FamilyGroup @relation(fields: [familyId], references: [id], onDelete: Cascade)
  provider          String // "claude" | "chatgpt" | "gemini"
  authId            String // CLIProxy 파일명 ID (예: "claude-foo@bar.json")
  email             String
  connectedByUserId String
  connectedBy       User        @relation(fields: [connectedByUserId], references: [id])
  status            String      @default("active") // "active" | "disconnected"
  lastUsedAt        DateTime?
  createdAt         DateTime    @default(now())

  @@unique([familyId, provider]) // 가족당 provider 1개씩만
  @@index([authId])
}

// Manual paste OAuth flow 진행 중인 세션.
// 사용자가 어떤 state로 시작했는지 기억해야 callback URL paste 시 검증 가능.
// CLIProxy 측 state TTL은 10분 — expiresAt 지나면 정리.
model FamilyOAuthSession {
  id        String      @id @default(cuid())
  familyId  String
  family    FamilyGroup @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  provider  String // "claude" | "chatgpt" | "gemini"
  state     String      @unique // CLIProxy가 발급한 state
  createdAt DateTime    @default(now())
  expiresAt DateTime

  @@index([familyId, provider])
}

// 엑셀 일괄 등록 시 사용자가 한 번 확정한 매핑을 재사용.
// 뱅크샐러드 표기명(예: "종합매매") → dondoc 계좌·holding·cash-sub·신규·무시
enum ExcelMappingType {
  ACCOUNT // 일반 잔액 동기화 대상 — targetAccountId
  CASH_SUB // 부모 account의 자식 "예수금"으로 — targetAccountId (parent)
  HOLDING_SKIP // 종목 row가 부모 account에 holding으로 등록됨 — 잔액 동기화 skip
  NEW_ACCOUNT // 신규 account 생성 대상
  IGNORE // 동기화 영구 제외 (사용자가 등록 안 함)
}

model ExcelMapping {
  id              String           @id @default(cuid())
  familyId        String
  family          FamilyGroup      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  excelName       String // 정규화된 엑셀 표기명
  mappingType    ExcelMappingType
  targetAccountId String? // account 매칭 또는 cash-sub 부모
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([familyId, excelName])
  @@index([familyId])
}

// 환율 — 글로벌 단일 row per pair. USDKRW 등.
// 시세 새로고침 시 클라이언트가 yahoo에서 fetch 후 서버에 저장해서, 서버 측 자산 합산 로직도 변환 가능.
model ExchangeRate {
  pair      String   @id // "USDKRW" 같은 식별자
  rate      Float
  updatedAt DateTime @updatedAt
}

// ── 공모주·스팩 워크스페이스 ────────────────────────────────────────────────
// /dashboard/ipo 의 계좌·청약원장·스팩·메모·오버라이드를 userId당 JSON 문서 1개로
// 영속화(멀티기기 동기화). 접근 패턴이 load-all/save-all이라 문서 모델이 적합.
// 필요 시 나중에 관계형(IpoAccount/IpoSubscription/IpoSpac)으로 정규화 가능.
model IpoWorkspace {
  userId    String   @id // Clerk 기반 앱 User.id (워크스페이스 소유자)
  data      Json // { accounts, ledger, spacs, memos, overrides }
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
