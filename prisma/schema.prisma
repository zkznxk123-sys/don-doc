// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CFO    // 관리자: 전체 자산 흐름 파악 및 예산 설정
  MEMBER // 구성원: 개인 지출 및 공동 지출 기여
}

enum Visibility {
  SHARED  // 가족 모두에게 상세 내역 공개
  PRIVATE // 본인 외에는 '합계'만 노출 (상세 내역 마스킹)
}

enum AccountType {
  CASH        // 현금/예적금
  INVESTMENT  // 주식/펀드
  CRYPTO      // 가상자산
  REAL_ESTATE // 부동산
  STO         // 토큰증권 (장기 확장성)
}

model FamilyGroup {
  id        String        @id @default(cuid())
  name      String        // 예: "우리집 패밀리오피스"
  users     User[]
  accounts  Account[]
  invites   FamilyInvite[]
  createdAt DateTime      @default(now())
}

model FamilyInvite {
  id        String      @id @default(cuid())
  code      String      @unique // 8자리 초대 코드 (XXXX-XXXX)
  familyId  String
  family    FamilyGroup @relation(fields: [familyId], references: [id])
  createdBy String      // CFO userId
  usedBy    String?     // 사용한 유저 email
  usedAt    DateTime?
  expiresAt DateTime    // 만료 시각
  createdAt DateTime    @default(now())
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  role          Role        @default(MEMBER)
  familyId      String
  family        FamilyGroup @relation(fields: [familyId], references: [id])
  transactions  Transaction[]
  accounts      Account[]
}

model Account {
  id            String      @id @default(cuid())
  name          String      // 예: "생활비 통장", "개인 비상금"
  type          AccountType @default(CASH)
  balance       Float       @default(0)
  isShared      Boolean     @default(true) // 공동 자산 여부
  familyId      String
  family        FamilyGroup @relation(fields: [familyId], references: [id])
  userId        String?     // 개인 계좌일 경우 소유자
  user          User?       @relation(fields: [userId], references: [id])
  transactions  Transaction[]
}

model Transaction {
  id          String     @id @default(cuid())
  amount      Float
  date        DateTime   @default(now())
  description String     // 이 필드가 마스킹 대상
  category    String     // 식비, 주거, 취미 등
  visibility  Visibility @default(SHARED)
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  accountId   String
  account     Account    @relation(fields: [accountId], references: [id])
}
