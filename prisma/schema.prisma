// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CFO    // 관리자: 전체 자산 흐름 파악 및 예산 설정
  MEMBER // 구성원: 개인 지출 및 공동 지출 기여
}

enum CategoryType {
  EXPENSE // 지출 카테고리
  INCOME  // 수입 카테고리
}

enum Visibility {
  SHARED  // 가족 모두에게 상세 내역 공개
  PRIVATE // 본인 외에는 '합계'만 노출 (상세 내역 마스킹)
}

enum AccountType {
  CASH        // 현금/예적금
  INVESTMENT  // 주식/펀드
  PENSION     // 연금 (IRP, 연금저축 등)
  CRYPTO      // 가상자산
  REAL_ESTATE // 부동산
  STO         // 토큰증권 (장기 확장성)
  DEBT        // 대출 (부채)
  CREDIT_CARD // 신용카드 (부채)
}

enum ShareLevel {
  PUBLIC       // 내역까지 공개 — 가족 모두가 볼 수 있음
  BALANCE_ONLY // 금액만 합산 — 이름/내역 숨김, 금액만 표시
  PRIVATE      // 나만 보기 — 타인 리스트에서 완전 제외
}

enum RepaymentType {
  EQUAL_PRINCIPAL_INTEREST // 원리금균등
  EQUAL_PRINCIPAL          // 원금균등
  BULLET                   // 만기일시
  INTEREST_ONLY            // 이자만납부
}

enum DebtType {
  MORTGAGE        // 주택담보대출
  JEONSE_DEPOSIT  // 전세보증금(수취)
  CREDIT_LOAN     // 신용대출
  OVERDRAFT       // 마이너스통장
  ETC             // 기타
}

enum PensionType {
  PUBLIC_PENSION   // 공적연금 (국민연금, 공무원연금 등)
  RETIREMENT_DB    // 퇴직연금 DB형 (확정급여형)
  RETIREMENT_DC    // 퇴직연금 DC형 (확정기여형)
  IRP              // 개인형 퇴직연금 (IRP)
  PERSONAL_PENSION // 개인연금 (연금저축펀드/보험)
  HOME_PENSION     // 주택연금
}

model FamilyGroup {
  id                String             @id @default(cuid())
  name              String             // 예: "우리집 패밀리오피스"
  users             User[]
  accounts          Account[]
  invites           FamilyInvite[]
  budgets           Budget[]
  categories        Category[]
  monthlyGoals      MonthlyGoal[]
  accountTypeLabels  AccountTypeLabel[]
  netWorthSnapshots  NetWorthSnapshot[]
  createdAt          DateTime           @default(now())
}

model Category {
  id           String        @id @default(cuid())
  name         String
  icon         String
  type         CategoryType
  familyId     String?       // null = 시스템 기본값, non-null = 가족 커스텀
  family       FamilyGroup?  @relation(fields: [familyId], references: [id])
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model FamilyInvite {
  id        String      @id @default(cuid())
  code      String      @unique // 6자리 초대 코드 (대문자+숫자)
  familyId  String
  family    FamilyGroup @relation(fields: [familyId], references: [id])
  createdBy String      // CFO userId
  usedBy    String?     // 사용한 유저 email
  usedAt    DateTime?
  expiresAt DateTime    // 만료 시각
  createdAt DateTime    @default(now())
}

model User {
  id                     String                   @id @default(cuid())
  clerkId                String?                  @unique // Clerk user ID (user_xxxx)
  email                  String                   @unique
  name                   String?
  role                   Role                     @default(MEMBER)
  familyId               String?
  family                 FamilyGroup?             @relation(fields: [familyId], references: [id])
  transactions           Transaction[]
  accounts               Account[]
  budgets                Budget[]
  categoryPreferences    UserCategoryPreference[]
}

model PensionDetail {
  id                     String      @id @default(cuid())
  accountId              String      @unique
  account                Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pensionType            PensionType @default(PERSONAL_PENSION)
  institutionName        String?     // 기관명 (예: 국민연금공단, 삼성생명)
  expectedMonthlyPension Float?      // 예상 월 수령액
  taxDeductible          Boolean     @default(false) // 세액공제 대상 (IRP/개인연금)
  accumulatedMonths      Int?        // 누적 납입 개월 수
  pensionStartAge        Int?        // 연금 개시 예정 나이
  monthlyPayment         Float?      // 월 납입액
  ownerBirthYear         Int?        // 가입자 출생연도 (수령까지 남은 기간 계산)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model UserCategoryPreference {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword    String   // normalized description (lowercase, trimmed)
  categoryId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, keyword])
}

model Account {
  id              String      @id @default(cuid())
  name            String      // 예: "생활비 통장", "개인 비상금"
  type            AccountType @default(CASH)
  balance         Float       @default(0)
  isShared        Boolean     @default(true)   // 공동 자산 여부 (shareLevel에서 파생)
  shareLevel      ShareLevel  @default(PUBLIC) // 공유 수준
  familyId        String
  family          FamilyGroup @relation(fields: [familyId], references: [id])
  userId          String?     // 명의자 (null = 미설정 or 공동)
  user            User?       @relation(fields: [userId], references: [id])
  isJoint         Boolean     @default(false) // 공동 명의 여부
  transactions    Transaction[]

  // 계층 구조 — 예: IRP → 채권펀드, 미래에셋계좌 → 국내주식펀드
  parentAccountId String?
  parentAccount   Account?    @relation("SubAccounts", fields: [parentAccountId], references: [id])
  subAccounts     Account[]   @relation("SubAccounts")

  // 부채가 종속된 자산 (self-relation) — 예: 주택담보대출 → 아파트
  linkedAssetId   String?
  linkedAsset     Account?    @relation("DebtToAsset", fields: [linkedAssetId], references: [id])
  linkedDebts     Account[]   @relation("DebtToAsset")

  // 유형별 상세 정보 (1:1)
  realEstateDetail    RealEstateDetail?
  financialAssetDetail FinancialAssetDetail?
  debtDetail          DebtDetail?
  pensionDetail       PensionDetail?
}

model Transaction {
  id           String     @id @default(cuid())
  amount       Float
  date         DateTime   @default(now())
  description  String     // 이 필드가 마스킹 대상
  category     String     // 카테고리 이름 (표시용, 하위호환)
  categoryId   String?    // Category 모델 FK (선택)
  categoryRef  Category?  @relation(fields: [categoryId], references: [id])
  visibility   Visibility @default(SHARED)
  isExcluded        Boolean    @default(false) // 통계 제외 여부
  excludeFromBudget Boolean    @default(false) // 예산 집계 제외 여부
  originalHash String?    @unique        // 엑셀 원본 Row 식별자 SHA-256 (userId|date|amount|desc|accountName)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  accountId    String
  account      Account    @relation(fields: [accountId], references: [id])
  // 분할 항목 (self-relation)
  parentId     String?
  parent       Transaction?  @relation("SubTransactions", fields: [parentId], references: [id], onDelete: Cascade)
  subItems     Transaction[] @relation("SubTransactions")
}

model RealEstateDetail {
  id            String   @id @default(cuid())
  accountId     String   @unique
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  propertyType  String?  // 아파트, 빌라, 오피스텔, 토지 등
  purchasePrice Float?   // 매수 원금 (취득가)
  purchaseDate  DateTime? // 매수일
  currentPrice  Float?   // 현재 시세 (사용자 수기 입력)
  targetPrice   Float?   // 목표 매도가
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FinancialAssetDetail {
  id             String    @id @default(cuid())
  accountId      String    @unique
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  interestRate   Float?    // 수익률 또는 이율 (% 단위, 예: 4.5)
  maturityDate   DateTime? // 만기일
  monthlyPayment Float?    // 월 납입액 (적금 등)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model DebtDetail {
  id             String         @id @default(cuid())
  accountId      String         @unique
  account        Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  debtType       DebtType       @default(ETC) // 부채 세부 유형
  interestRate   Float?         // 대출 금리 (% 단위, 예: 3.8)
  maturityDate   DateTime?      // 대출 만기일
  repaymentType  RepaymentType? // 상환 방식
  monthlyPayment Float?         // 월 상환액
  includeInLtv   Boolean        @default(true) // LTV 계산 포함 여부
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Budget {
  id        String      @id @default(cuid())
  amount    Float
  month     String      // "YYYY-MM"
  familyId  String
  family    FamilyGroup @relation(fields: [familyId], references: [id])
  userId    String?     // null = 가족 전체 예산, non-null = 특정 멤버 예산
  user      User?       @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model AccountTypeLabel {
  id       String      @id @default(cuid())
  type     AccountType
  label    String
  familyId String
  family   FamilyGroup @relation(fields: [familyId], references: [id])

  @@unique([type, familyId])
}

model NetWorthSnapshot {
  id               String      @id @default(cuid())
  familyId         String
  family           FamilyGroup @relation(fields: [familyId], references: [id])
  yearMonth        String      // "YYYY-MM"
  totalAssets      Float       @default(0)
  totalLiabilities Float       @default(0)
  netWorth         Float       @default(0)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([familyId, yearMonth])
}

model MonthlyGoal {
  id                String      @id @default(cuid())
  month             String      // "YYYY-MM"
  targetIncome      Float       @default(0)
  targetExpense     Float       @default(0)
  targetSavingsRate Float       @default(0)  // 퍼센트 (예: 30.0 = 30%)
  familyId          String
  family            FamilyGroup @relation(fields: [familyId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([familyId, month])
}
