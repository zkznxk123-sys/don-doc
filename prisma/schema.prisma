// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CFO    // 관리자: 전체 자산 흐름 파악 및 예산 설정
  MEMBER // 구성원: 개인 지출 및 공동 지출 기여
}

enum CategoryType {
  EXPENSE // 지출 카테고리
  INCOME  // 수입 카테고리
}

enum Visibility {
  SHARED  // 가족 모두에게 상세 내역 공개
  PRIVATE // 본인 외에는 '합계'만 노출 (상세 내역 마스킹)
}

enum AccountType {
  CASH        // 현금/예적금
  INVESTMENT  // 주식/펀드
  CRYPTO      // 가상자산
  REAL_ESTATE // 부동산
  STO         // 토큰증권 (장기 확장성)
  DEBT        // 대출 (부채)
  CREDIT_CARD // 신용카드 (부채)
}

enum ShareLevel {
  PUBLIC       // 내역까지 공개 — 가족 모두가 볼 수 있음
  BALANCE_ONLY // 금액만 합산 — 이름/내역 숨김, 금액만 표시
  PRIVATE      // 나만 보기 — 타인 리스트에서 완전 제외
}

model FamilyGroup {
  id           String        @id @default(cuid())
  name         String        // 예: "우리집 패밀리오피스"
  users        User[]
  accounts     Account[]
  invites      FamilyInvite[]
  budgets      Budget[]
  categories   Category[]
  monthlyGoals MonthlyGoal[]
  createdAt    DateTime      @default(now())
}

model Category {
  id           String        @id @default(cuid())
  name         String
  icon         String
  type         CategoryType
  familyId     String?       // null = 시스템 기본값, non-null = 가족 커스텀
  family       FamilyGroup?  @relation(fields: [familyId], references: [id])
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

model FamilyInvite {
  id        String      @id @default(cuid())
  code      String      @unique // 6자리 초대 코드 (대문자+숫자)
  familyId  String
  family    FamilyGroup @relation(fields: [familyId], references: [id])
  createdBy String      // CFO userId
  usedBy    String?     // 사용한 유저 email
  usedAt    DateTime?
  expiresAt DateTime    // 만료 시각
  createdAt DateTime    @default(now())
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  role          Role         @default(MEMBER)
  familyId      String?
  family        FamilyGroup? @relation(fields: [familyId], references: [id])
  transactions  Transaction[]
  accounts      Account[]
  budgets       Budget[]
}

model Account {
  id            String      @id @default(cuid())
  name          String      // 예: "생활비 통장", "개인 비상금"
  type          AccountType @default(CASH)
  balance       Float       @default(0)
  isShared      Boolean     @default(true) // 공동 자산 여부 (shareLevel에서 파생)
  shareLevel    ShareLevel  @default(PUBLIC) // 공유 수준
  familyId      String
  family        FamilyGroup @relation(fields: [familyId], references: [id])
  userId        String?     // 개인 계좌일 경우 소유자
  user          User?       @relation(fields: [userId], references: [id])
  transactions  Transaction[]
}

model Transaction {
  id          String     @id @default(cuid())
  amount      Float
  date        DateTime   @default(now())
  description String     // 이 필드가 마스킹 대상
  category    String     // 카테고리 이름 (표시용, 하위호환)
  categoryId  String?    // Category 모델 FK (선택)
  categoryRef Category?  @relation(fields: [categoryId], references: [id])
  visibility  Visibility @default(SHARED)
  isExcluded  Boolean    @default(false) // 통계 제외 여부
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  accountId   String
  account     Account    @relation(fields: [accountId], references: [id])
}

model Budget {
  id        String      @id @default(cuid())
  amount    Float
  month     String      // "YYYY-MM"
  familyId  String
  family    FamilyGroup @relation(fields: [familyId], references: [id])
  userId    String?     // null = 가족 전체 예산, non-null = 특정 멤버 예산
  user      User?       @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model MonthlyGoal {
  id                String      @id @default(cuid())
  month             String      // "YYYY-MM"
  targetIncome      Float       @default(0)
  targetExpense     Float       @default(0)
  targetSavingsRate Float       @default(0)  // 퍼센트 (예: 30.0 = 30%)
  familyId          String
  family            FamilyGroup @relation(fields: [familyId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([familyId, month])
}
